# Business Formation Coach — Phase 1 environment variables.
# No database in Phase 1. Every AFFILIATE_URL_* var is optional — until
# it's set, that option just shows "Link coming soon" in the UI instead
# of a live link. Fill each in once you've signed up for that affiliate
# program and have a real tracking link (see lib/affiliateLinks.ts).

# Formation services
AFFILIATE_URL_LEGALZOOM=
AFFILIATE_URL_ZENBUSINESS=
AFFILIATE_URL_NORTHWEST=
AFFILIATE_URL_INCFILE=

# Business banking
AFFILIATE_URL_MERCURY=
AFFILIATE_URL_BLUEVINE=
AFFILIATE_URL_NOVO=
AFFILIATE_URL_RELAY=

# Accounting / payroll
AFFILIATE_URL_QUICKBOOKS=
AFFILIATE_URL_XERO=
AFFILIATE_URL_WAVE=
AFFILIATE_URL_GUSTO=

# Credit cards
AFFILIATE_URL_CHASE_INK=
AFFILIATE_URL_AMEX_BUSINESS=
AFFILIATE_URL_CAPITAL_ONE_SPARK=

# Insurance
AFFILIATE_URL_NEXT_INSURANCE=
AFFILIATE_URL_SIMPLY_BUSINESS=
AFFILIATE_URL_THIMBLE=
