# Business Formation Coach — environment variables.

# Required — Postgres connection string and NextAuth config for accounts.
DATABASE_URL="postgresql://business_coach:CHANGE_ME@postgres:5432/business_coach"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://coach.myfinancial.help"

# Required for the AI-generated business plan feature (/business-plan).
# Without this set, generation returns a clear "not configured" error —
# everything else in the app still works fine. Get a key at
# console.anthropic.com. Never commit a real key to this file.
ANTHROPIC_API_KEY=

# Optional — comma-separated list of emails that get admin access
# (/admin: edit affiliate links without redeploying, manage accounts).
# Must match the email an account was signed up with. Leave blank and
# nobody has admin access.
ADMIN_EMAILS=

# Required for password reset, email verification, and compliance
# reminder emails. Without this, those features log a warning and no-op —
# everything else still works, but users who forget their password have
# no recovery path. Get a key at resend.com (free tier: 3,000 emails/mo).
# EMAIL_FROM must be a verified sender/domain in your Resend account.
RESEND_API_KEY=
EMAIL_FROM="Business Formation Coach <noreply@yourdomain.com>"

# Optional but recommended — screens new signups for invalid, disposable,
# abuse, and spam-trap addresses before creating an account. Provider errors
# fail open; the emailed verification link remains the proof of ownership.
ZEROBOUNCE_API_KEY=
# Use https://api-eu.zerobounce.net/v2/validate when EU processing is required.
ZEROBOUNCE_API_URL="https://api.zerobounce.net/v2/validate"

# Required for the compliance-reminder cron endpoint
# (/api/cron/send-reminders) to accept requests — see DEPLOYMENT.md for
# the crontab entry that calls it daily. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional — page-view and funnel analytics via Plausible
# (plausible.io or a self-hosted instance). Set to your site's domain as
# registered in Plausible, e.g. "coach.myfinancial.help". Leave blank and
# no analytics script loads at all — no account required to run the app.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Required for the paid "business plan review" upsell
# (/business-plan). Without these, the upsell card shows "not set up
# yet" instead of a checkout button — everything else still works. Get
# keys at dashboard.stripe.com. STRIPE_PRICE_ID is optional — if unset, a
# Checkout Session is created ad-hoc using PLAN_REVIEW_PRICE_CENTS instead
# (defaults to 9900 = $99). STRIPE_WEBHOOK_SECRET comes from the webhook
# endpoint you register in Stripe for /api/webhooks/stripe, listening for
# checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PLAN_REVIEW_PRICE_CENTS=9900

# Everything below is optional — until an AFFILIATE_URL_* var is set,
# that option just shows "Link coming soon" in the UI instead of a live
# link. Fill each in once you've signed up for that affiliate program
# and have a real tracking link (see lib/affiliateLinks.ts).

# Formation services
AFFILIATE_URL_LEGALZOOM=
AFFILIATE_URL_ZENBUSINESS=
AFFILIATE_URL_NORTHWEST=
AFFILIATE_URL_INCFILE=

# Business banking
AFFILIATE_URL_MERCURY=
AFFILIATE_URL_BLUEVINE=
AFFILIATE_URL_NOVO=
AFFILIATE_URL_RELAY=

# Accounting / payroll
AFFILIATE_URL_QUICKBOOKS=
AFFILIATE_URL_XERO=
AFFILIATE_URL_WAVE=
AFFILIATE_URL_GUSTO=

# Credit cards
AFFILIATE_URL_CHASE_INK=
AFFILIATE_URL_AMEX_BUSINESS=
AFFILIATE_URL_CAPITAL_ONE_SPARK=

# Insurance
AFFILIATE_URL_NEXT_INSURANCE=
AFFILIATE_URL_SIMPLY_BUSINESS=
AFFILIATE_URL_THIMBLE=

