generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  hashedPassword      String
  emailVerifiedAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  stageProgress       StageProgress[]
  businessProfile     BusinessProfile?
  businessPlanInput   BusinessPlanInput?
  businessPlanDocument BusinessPlanDocument?
  feedback            Feedback[]
  verificationTokens  VerificationToken[]
  reminderLogs        ReminderLog[]
  planReviewOrders    PlanReviewOrder[]
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// Single-use tokens emailed to a user for password reset or email
/// verification, distinguished by `purpose`. Looked up by the raw token
/// value (itself the unguessable secret — no separate hashing layer,
/// consistent with this app's other pragmatic-default security choices),
/// checked against `expiresAt`, and marked `usedAt` on consumption so a
/// link can't be replayed.
model VerificationToken {
  id        String       @id @default(cuid())
  token     String       @unique
  purpose   TokenPurpose
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
}

/// Records that a reminder email for a specific deadline instance has
/// already gone out, so the daily cron endpoint doesn't re-send the same
/// reminder every day between now and the deadline. `deadlineKey` is the
/// reminder id from lib/calc/reminders.ts plus the computed due date
/// (e.g. "annual-report:2027-03-15"), so a new deadline instance (next
/// year's annual report) naturally gets its own reminder.
model ReminderLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderId   String
  deadlineKey  String
  sentAt       DateTime @default(now())

  @@unique([userId, reminderId, deadlineKey])
}

/// One paid request for a human review of a user's AI-generated business
/// plan before it goes to a lender. Created in "pending_payment" when a
/// Stripe Checkout Session starts, flipped to "paid" by the Stripe webhook,
/// and moved to "completed" manually by an admin once the review is done
/// (see /admin) — there's no automated reviewer pipeline, a person on the
/// One With Digital team does this.
model PlanReviewOrder {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String   @default("pending_payment")
  stripeSessionId String?  @unique
  amountCents     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model StageProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId     Int
  completedAt DateTime @default(now())

  @@unique([userId, stageId])
  @@index([userId])
}

/// One profile per user — the minimum info needed to turn Stage 10's
/// generic reminder text into dates specific to this business. Optional:
/// nothing else in the app requires it to be filled in.
model BusinessProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType    String?
  state         String?
  formationDate DateTime?
  updatedAt     DateTime  @updatedAt
}

/// Answers to the business-plan questionnaire — the narrative/numeric inputs
/// the interactive tools don't already persist (those are client-only state
/// today). Feeds the AI-generated business plan document.
model BusinessPlanInput {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName         String?
  onePagerPitch        String?
  targetCustomer       String?
  problemSolved        String?
  revenueModel         String?
  competitiveEdge      String?
  startupCosts         Float?
  monthlyCosts         Float?
  pricePerUnit         Float?
  variableCostPerUnit  Float?
  expectedMonthlyUnits Float?
  unitLabel            String?
  marketingPlan        String?
  fundingNeeded        Boolean  @default(false)
  fundingAmount        Float?
  fundingUse           String?
  milestones           String?
  updatedAt            DateTime @updatedAt
}

/// The latest AI-generated business plan for a user. Regenerating replaces
/// it (one document per user, not a history) — generation is gated and
/// rate-limited server-side, see /api/business-plan/generate.
model BusinessPlanDocument {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// { sections: { heading: string; paragraphs: string[] }[] }
  content     Json
  generatedAt DateTime @default(now())
}

/// Admin-editable override for an affiliate link's real URL, keyed by the
/// AffiliateLink.id from lib/affiliateLinks.ts (e.g. "mercury"). Lets an
/// admin update a link from /admin without touching env vars or
/// redeploying. When no row exists for a given id, the app falls back to
/// that link's AFFILIATE_URL_* env var — see getAffiliateUrl in
/// lib/affiliateLinks.ts.
model AffiliateOverride {
  id        String   @id
  url       String
  updatedAt DateTime @updatedAt
}

/// Feedback submitted from the site-wide feedback widget. Available to
/// guests too (userId/email nullable) — kept even if the submitting
/// account is later deleted (SetNull, not Cascade), since the feedback
/// itself stays useful for product decisions independent of the account.
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  message   String
  rating    Int?
  page      String?
  createdAt DateTime @default(now())

  @@index([userId])
}
